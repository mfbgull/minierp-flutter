p-flutter/server/src/models/Expense.ts", "source_location": "L65"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L101"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L102"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L103"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L104"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L105"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L109"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L118"}, {"caller_nid": "expense_getall", "callee": "all", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L120"}, {"caller_nid": "expense_getall", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L120"}, {"caller_nid": "expense_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L127"}, {"caller_nid": "expense_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L128"}, {"caller_nid