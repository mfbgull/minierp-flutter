seDate: data.expense_date,\n      paymentMethod: data.payment_method || 'cash',\n      userId: data.created_by,\n    });\n\n    return newId;\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L64"}, {"caller_nid": "expense_create", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L64"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L107"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L108"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L109"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L110"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L111"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L115"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L119"}, {"caller_nid": "expense_getall", "callee": "all", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L121"}, {"caller_nid": "expense_getall", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_