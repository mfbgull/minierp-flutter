ierp-flutter/server/src/models/Expense.ts", "source_location": "L53"}, {"caller_nid": "expense_generateexpenseno", "callee": "getMonth", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L53"}, {"caller_nid": "expense_generateexpenseno", "callee": "getNextSequenceNumber", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L60"}, {"caller_nid": "expense_generateexpenseno", "callee": "padStart", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L61"}, {"caller_nid": "expense_generateexpenseno", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L61"}, {"caller_nid": "expense_create", "callee": "db.transaction(() => {\n    const result = db.prepare(`\n      INSERT INTO expenses (\n        expense_no, expense_category, description, amount, expense_date,\n        payment_method, reference_no, vendor_name, project, status, created_by\n      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `).run(\n      data.expense_no, data.expense_category, data.description, data.amount, data.expense_date,\n      data.payment_method || null, data.reference_no || null, data.vendor_name || null,\n      data.project || null, data.status, data.created_by\n    );\n    const newId = result.lastInsertRowid as number;\n\n    // GL posting (ACC-04): Dr 6000 Operating Expenses /\n    // Cr cash-per-method. Expenses default to Approved on entry, so\n    // posting at creation matches when the cash effect occurs.\n    // Funds guard: reject payouts that would overdraw the selected\n    // account as of the expense date (same primitive reports use).\n    const fundsCashCode = AccountingService._cashOrBankAccountCode(data.payment_method || 'cash');\n    const fundsAccount = AccountingService.getAccountByCode(db, fundsCashCode);\n    if (!fundsAccount) {\n      throw new Error(`Chart of accounts is missing required account: ${fundsCashCode}`);\n    }\n    AccountingService.assertSufficientFunds(db, {\n      accountId: fundsAccount.id,\n      amount: data.amount,\n      asOfDate: data.expense_date,\n      label: `expense ${data.expense_no}`,\n    });\n    AccountingService.postExpenseEntry(db, {\n      expenseId: newId,\n      expenseNo: data.expense_no,\n      amount: data.amount,\n      expenseDate: data.expense_date,\n      paymentMethod: data.payment_method || 'cash',\n      userId: data.created_by,\n    });\n\n    return newId;\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L65"}, {"caller_nid": "expense_create", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L65"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L121"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L122"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L123"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L124"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L125"}, {"caller_nid": "expense_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/Expense.ts", "source_location": "L129"}, {"caller_nid": "expense_getall"