ller.ts", "source_location": "L166"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "parseInt", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L173"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "json", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L182"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "status", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L182"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "db.transaction(() => {\n      // Fetch purchase first to get its number for the GL entry\n      const purchase = Purchase.getById(purchaseId, db);\n      if (!purchase) throw new Error('Purchase not found');\n\n      // Return stock and get the cost for GL posting\n      result = Purchase.returnPurchaseItems(db, purchaseId, quantity, userId, reason);\n\n      // Post GL reversal \u2014 Dr AP, Cr Inventory\n      AccountingService.postPurchaseReturnEntry(db, {\n        purchaseId,\n        purchaseNo: purchase.purchase_no,\n        returnAmount: result.totalCost,\n        returnDate: new Date().toISOString().split('T')[0],\n        userId,\n      });\n    })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L188"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L188"}, {"caller_nid": "purchasecontroller_returnpurchaseitems", "callee": "json", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/controllers/purchaseController.ts", "source_location": "L206"}, {"ca