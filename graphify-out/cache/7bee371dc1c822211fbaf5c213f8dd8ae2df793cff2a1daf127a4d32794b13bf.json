7/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L131"}, {"caller_nid": "ownerwithdrawal_nextadjbatchno", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L131"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "abs", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L151"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "Number", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L151"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L156"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L156"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L167"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L167"}, {"caller_nid": "ownerwithdrawal_restoreconsumption", "callee": "recordMovement", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L180"}, {"caller_nid": "ownerwithdrawal_insertitems", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L199"}, {"caller_nid": "ownerwithdrawal_insertitems", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L203"}, {"caller_nid": "ownerwithdrawal_create", "callee": "db.transaction(() => {\n    if (data.kind === 'cash') {\n      const amount = Number(data.amount);\n      if (!Number.isFinite(amount) || amount <= 0) {\n        throw new Error('Cash withdrawal amount must be a positive number');\n      }\n      const result = db.prepare(`\n        INSERT INTO owner_withdrawals (\n          withdrawal_no, withdrawal_date, kind, amount, payment_method, note, status, created_by\n        ) VALUES (?, ?, 'cash', ?, ?, ?, 'posted', ?)\n      `).run(\n        data.withdrawal_no, data.withdrawal_date, amount,\n        data.payment_method || 'cash', data.note || null, data.created_by\n      );\n      const newId = result.lastInsertRowid as number;\n\n      AccountingService.assertNoActivePosting(db, 'OWNER_WITHDRAWAL', newId);\n      const cashCode = AccountingService._cashOrBankAccountCode(data.payment_method || 'cash');\n      const cash = AccountingService.getAccountByCode(db, cashCode);\n      if (!cash) throw new Error(`Chart of accounts is missing required account: ${cashCode}`);\n      AccountingService.assertSufficientFunds(db, {\n        accountId: cash.id,\n        amount,\n        asOfDate: data.withdrawal_date,\n        label: `owner withdrawal ${data.withdrawal_no}`,\n      });\n      AccountingService.postOwnerWithdrawalCashEntry(db, {\n        withdrawalId: newId,\n        withdrawalNo: data.withdrawal_no,\n        amount,\n        withdrawalDate: data.withdrawal_date,\n        paymentMethod: data.payment_method || 'cash',\n        userId: data.created_by,\n      });\n      return { id: newId, amount };\n    }\n\n    // ---- goods kind -------------------------------------------------\n    const items = data.items ?? [];\n    if (items.length === 0) {\n      throw new Error('A goods withdrawal requires at least one item line');\n    }\n\n    // Consume FIRST (validates availability + costs the withdrawal).\n    // Runs inside this transaction, so decrements roll back on any failure.\n    const { consumption, totalCost } = consumeForLines(db, items);\n    if (totalCost <= 0) {\n      throw new Error(\n        'Goods withdrawal value computed as zero \u2014 item cost data (batches/standard_cost) is missing'\n      );\n    }\n\n    const result = db.prepare(`\n      INSERT INTO owner_withdrawals (\n        withdrawal_no, withdrawal_date, kind, amount, note, status, created_by\n      ) VALUES (?, ?, 'goods', ?, ?, 'posted', ?)\n    `).run(data.withdrawal_no, data.withdrawal_date, totalCost, data.note || null, data.created_by);\n    const newId = result.lastInsertRowid as number;\n\n    insertItems(db, newId, items);\n\n    // One movement row per consumed batch (invoice COGS pattern).\n    for (const e of consumption) {\n      StockMovementModel.recordMovement({\n        item_id: e.item_id,\n        warehouse_id: e.warehouse_id,\n        movement_type: 'OWNER_WITHDRAWAL',\n        quantity: -e.consumed,\n        unit_cost: e.unitCost,\n        reference_doctype: 'OWNER_WITHDRAWAL',\n        reference_docno: data.withdrawal_no,\n        remarks: `Owner withdrawal ${data.withdrawal_no}`,\n        movement_date: data.withdrawal_date,\n        batch_id: e.batchId ?? undefined,\n      }, data.created_by, db);\n    }\n\n    AccountingService.assertNoActivePosting(db, 'OWNER_WITHDRAWAL', newId);\n    AccountingService.postOwnerWithdrawalGoodsEntry(db, {\n      withdrawalId: newId,\n      withdrawalNo: data.withdrawal_no,\n      totalCost,\n      withdrawalDate: data.withdrawal_date,\n      userId: data.created_by,\n    });\n\n    return { id: newId, amount: totalCost };\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L207"}, {"caller_nid": "ownerwithdrawal_create", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L207"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "exec", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L306"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "consumeFromOldestBatches", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L311"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "map", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L315"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L319"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "exec", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L324"}, {"caller_nid": "ownerwithdrawal_quote", "callee": "exec", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L325"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L345"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L349"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L350"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L351"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L355"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L359"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "all", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L361"}, {"caller_nid": "ownerwithdrawal_getall", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L361"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L370"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L374"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L375"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L376"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "push", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L380"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "get", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L383"}, {"caller_nid": "ownerwithdrawal_getcount", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L383"}, {"caller_nid": "ownerwithdrawal_getbyid", "callee": "get", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L387"}, {"caller_nid": "ownerwithdrawal_getbyid", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L387"}, {"caller_nid": "ownerwithdrawal_getitems", "callee": "all", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L396"}, {"caller_nid": "ownerwithdrawal_getitems", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L396"}, {"caller_nid": "ownerwithdrawal_getmovements", "callee": "all", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L408"}, {"caller_nid": "ownerwithdrawal_getmovements", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L408"}, {"caller_nid": "ownerwithdrawal_update", "callee": "assertPeriodNotClosed", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L438"}, {"caller_nid": "ownerwithdrawal_update", "callee": "Number", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L442"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L445"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L445"}, {"caller_nid": "ownerwithdrawal_update", "callee": "Number", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L446"}, {"caller_nid": "ownerwithdrawal_update", "callee": "Number", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L446"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L447"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L447"}, {"caller_nid": "ownerwithdrawal_update", "callee": "db.transaction(() => {\n      if (moneyChanged) {\n        if (!(newAmount > 0)) throw new Error('Cash withdrawal amount must be a positive number');\n\n        AccountingService.voidJournalLinesByReference(db, 'OWNER_WITHDRAWAL', id, {\n          voidedBy: opts.userId ?? null,\n          voidReason: 'Re-posted after edit',\n        });\n\n        const cashCode = AccountingService._cashOrBankAccountCode(newMethod ?? undefined);\n        const cash = AccountingService.getAccountByCode(db, cashCode);\n        if (!cash) throw new Error(`Chart of accounts is missing required account: ${cashCode}`);\n        AccountingService.assertSufficientFunds(db, {\n          accountId: cash.id,\n          amount: newAmount,\n          asOfDate: newDate,\n          label: `owner withdrawal ${existing.withdrawal_no}`,\n        });\n\n        db.prepare(`\n          UPDATE owner_withdrawals SET withdrawal_date = ?, amount = ?, payment_method = ?,\n            note = COALESCE(?, note), updated_at = CURRENT_TIMESTAMP\n          WHERE id = ?\n        `).run(newDate, newAmount, newMethod, data.note ?? null, id);\n\n        AccountingService.postOwnerWithdrawalCashEntry(db, {\n          withdrawalId: id,\n          withdrawalNo: existing.withdrawal_no,\n          amount: newAmount,\n          withdrawalDate: newDate,\n          paymentMethod: newMethod ?? undefined,\n          userId: opts.userId,\n        });\n      } else {\n        db.prepare(`\n          UPDATE owner_withdrawals SET note = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?\n        `).run(data.note !== undefined ? data.note : existing.note, id);\n      }\n    })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L449"}, {"caller_nid": "ownerwithdrawal_update", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L449"}, {"caller_nid": "ownerwithdrawal_update", "callee": "Number", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L488"}, {"caller_nid": "ownerwithdrawal_update", "callee": "isArray", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L492"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L495"}, {"caller_nid": "ownerwithdrawal_update", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L495"}, {"caller_nid": "ownerwithdrawal_update", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L499"}, {"caller_nid": "ownerwithdrawal_update", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L499"}, {"caller_nid": "ownerwithdrawal_update", "callee": "db.transaction(() => {\n    const newDate = data.withdrawal_date ?? existing.withdrawal_date;\n    const newLines: WithdrawalItemInput[] = itemsProvided\n      ? (data.items as WithdrawalItemInput[])\n      : (getItems(db, id) as Array<{ item_id: number; warehouse_id: number; quantity: number }>).map(\n          (r) => ({ item_id: r.item_id, warehouse_id: r.warehouse_id, quantity: r.quantity })\n        );\n    if (newLines.length === 0) {\n      throw new Error('A goods withdrawal requires at least one item line');\n    }\n\n    // Restore the original consumption (compensating movements only),\n    // then void the old GL posting.\n    restoreConsumption(db, getOriginalMovements(db, existing.withdrawal_no), existing.withdrawal_no, opts.userId);\n    AccountingService.voidJournalLinesByReference(db, 'OWNER_WITHDRAWAL', id, {\n      voidedBy: opts.userId ?? null,\n      voidReason: 'Re-posted after edit',\n    });\n\n    // Fresh consumption at current FEFO/FIFO state.\n    const { consumption, totalCost } = consumeForLines(db, newLines);\n    if (totalCost <= 0) {\n      throw new Error('Goods withdrawal value computed as zero \u2014 item cost data (batches/standard_cost) is missing');\n    }\n\n    db.prepare('DELETE FROM owner_withdrawal_items WHERE withdrawal_id = ?').run(id);\n    insertItems(db, id, newLines);\n\n    for (const e of consumption) {\n      StockMovementModel.recordMovement({\n        item_id: e.item_id,\n        warehouse_id: e.warehouse_id,\n        movement_type: 'OWNER_WITHDRAWAL',\n        quantity: -e.consumed,\n        unit_cost: e.unitCost,\n        reference_doctype: 'OWNER_WITHDRAWAL',\n        reference_docno: existing.withdrawal_no,\n        remarks: `Owner withdrawal ${existing.withdrawal_no} (re-posted)`,\n        movement_date: newDate,\n        batch_id: e.batchId ?? undefined,\n      }, opts.userId, db);\n    }\n\n    db.prepare(`\n      UPDATE owner_withdrawals SET withdrawal_date = ?, amount = ?,\n        note = COALESCE(?, note), updated_at = CURRENT_TIMESTAMP\n      WHERE id = ?\n    `).run(newDate, totalCost, data.note ?? null, id);\n\n    AccountingService.postOwnerWithdrawalGoodsEntry(db, {\n      withdrawalId: id,\n      withdrawalNo: existing.withdrawal_no,\n      totalCost,\n      withdrawalDate: newDate,\n      userId: opts.userId,\n    });\n\n    return { amount: totalCost };\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L505"}, {"caller_nid": "ownerwithdrawal_update", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L505"}, {"caller_nid": "ownerwithdrawal_softvoid", "callee": "assertPeriodNotClosed", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L578"}, {"caller_nid": "ownerwithdrawal_softvoid", "callee": "db.transaction(() => {\n    if (existing.kind === 'goods') {\n      restoreConsumption(db, getOriginalMovements(db, existing.withdrawal_no), existing.withdrawal_no, opts.userId);\n    }\n    AccountingService.voidJournalLinesByReference(db, 'OWNER_WITHDRAWAL', id, {\n      voidedBy: opts.userId ?? null,\n      voidReason: opts.reason || 'Owner withdrawal voided',\n    });\n    db.prepare(`\n      UPDATE owner_withdrawals SET status = 'voided', voided_at = CURRENT_TIMESTAMP,\n        voided_by = ?, void_reason = ?, updated_at = CURRENT_TIMESTAMP\n      WHERE id = ?\n    `).run(opts.userId ?? null, opts.reason || 'Owner withdrawal voided', id);\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L580"}, {"caller_nid": "ownerwithdrawal_softvoid", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/models/OwnerWithdrawal.ts", "source_location": "L580"}]}