{"nodes": [{"id": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "label": "ledgerUtils.ts", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L1"}, {"id": "ledgerutils_createledgerentry", "label": "createLedgerEntry()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L14"}, {"id": "ledgerutils_reverseledgerentry", "label": "reverseLedgerEntry()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L72"}, {"id": "ledgerutils_calculateinvoicebalance", "label": "calculateInvoiceBalance()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L143"}, {"id": "ledgerutils_updateinvoicestatus", "label": "updateInvoiceStatus()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L171"}, {"id": "ledgerutils_rebuildledgerbalances", "label": "rebuildLedgerBalances()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L211"}, {"id": "ledgerutils_updatebalancesfrom", "label": "updateBalancesFrom()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L237"}, {"id": "ledgerutils_recalccustomerbalancefromledger", "label": "recalcCustomerBalanceFromLedger()", "file_type": "code", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L275"}], "edges": [{"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "media_fawad_26f2efa7f2ef79