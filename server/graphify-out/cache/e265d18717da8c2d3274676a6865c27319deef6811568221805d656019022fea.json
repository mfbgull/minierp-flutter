": "L72", "weight": 1.0}, {"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "ledgerutils_calculateinvoicebalance", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L143", "weight": 1.0}, {"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "ledgerutils_updateinvoicestatus", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L171", "weight": 1.0}, {"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "ledgerutils_rebuildledgerbalances", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L211", "weight": 1.0}, {"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "ledgerutils_updatebalancesfrom", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L237", "weight": 1.0}, {"source": "media_fawad_26f2efa7f2ef7987_d_minierp_flutter_server_src_utils_ledgerutils_ts", "target": "ledgerutils_recalccustomerbalancefromledger", "relation": "contains", "confidence": "EXTRACTED", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L275", "weight": 1.0}], "raw_calls": [{"caller_nid": "ledgerutils_createledgerentry", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L23"}, {"caller_nid": "ledgerutils_createledgerentry", "callee": "insertEntry", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L63"}, {"caller_nid": "ledgerutils_reverseledgerentry", "callee": "db.transaction(() => {\n    const original = db.prepare(\n      `SELECT * FROM ${table} WHERE id = ?`\n    ).get(rowId) as Record<string, unknown> | undefined;\n    if (!original) throw new Error(`Ledger row ${rowId} not found in ${table}`);\n    if (Number(original.voided) === 1) {\n      throw new Error(`Ledger row ${rowId} is already voided`);\n    }\n\n    const counterpartyKey = table === 'customer_ledger' ? 'customer_id' : 'supplier_id';\n    const counterpartyId = original[counterpartyKey] as number;\n    const debit = parseCurrency(original.debit as number);\n    const credit = parseCurrency(original.credit as number);\n    const originalType = String(original.transaction_type || '');\n\n    // The reversal is positioned where the original sat in the chain \u2014\n    // same transaction_date \u2014 so the rebuilt running balances treat the\n    // pair as a net-zero event at that point, not as an end-of-chain one.\n    const reversalDate = String(original.transaction_date || todayLocal());\n\n    // Latest non-voided balance for the counterparty.\n    const lastRow = db.prepare(\n      `SELECT balance FROM ${table}\n       WHERE ${counterpartyKey} = ? AND voided = 0\n       ORDER BY transaction_date DESC, id DESC LIMIT 1`\n    ).get(counterpartyId) as { balance: number } | undefined;\n    const lastBalance = parseCurrency(lastRow?.balance);\n    const reversalBalance = subtractCurrency(addCurrency(lastBalance, credit), debit);\n\n    const result = db.prepare(`\n      INSERT INTO ${table} (\n        ${counterpartyKey}, transaction_date, transaction_type, reference_no,\n        debit, credit, balance, description, reversed_by\n      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)\n    `).run(\n      counterpartyId,\n      reversalDate,\n      `REVERSAL:${originalType}`,\n      original.reference_no ?? null,\n      credit,   // swapped legs\n      debit,\n      reversalBalance,\n      `Reversal of ledger#${rowId}: ${reason}`,\n      rowId\n    );\n    const reversalId = result.lastInsertRowid as number;\n\n    db.prepare(`UPDATE ${table} SET voided = 1 WHERE id = ?`).run(rowId);\n\n    // Refresh stored balances for this counterparty in date order.\n    if (table === 'customer_ledger') {\n      rebuildLedgerBalances(counterpartyId);\n    } else {\n      SupplierLedgerModel.rebuildBalances(counterpartyId, db);\n    }\n\n    return reversalId;\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L81"}, {"caller_nid": "ledgerutils_reverseledgerentry", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L81"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "get", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L144"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L144"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "get", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L150"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L150"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L156"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L157"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L158"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L159"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "subtractCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L162"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "subtractCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L163"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "subtractCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L163"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L165"}, {"caller_nid": "ledgerutils_calculateinvoicebalance", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L165"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "get", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L172"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L172"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L179"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L180"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "parseCurrency", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L181"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "String", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L182"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "run", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L206"}, {"caller_nid": "ledgerutils_updateinvoicestatus", "callee": "prepare", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L206"}, {"caller_nid": "ledgerutils_rebuildledgerbalances", "callee": "db.transaction(() => {\n    // ACC-14: voided rows are out; a REVERSAL row (reversed_by set) is\n    // also excluded \u2014 its voided original is already gone, so keeping the\n    // active half of the pair would double-count the correction.\n    const entries = db.prepare(`\n      SELECT id, debit, credit FROM customer_ledger\n      WHERE customer_id = ? AND voided = 0 AND reversed_by IS NULL\n      ORDER BY transaction_date ASC, id ASC\n    `).all(customerId) as Array<{ id: number; debit: number; credit: number }>;\n\n    let runningBalance = 0;\n    const updateStmt = db.prepare('UPDATE customer_ledger SET balance = ? WHERE id = ?');\n\n    for (const entry of entries) {\n      runningBalance = addCurrency(subtractCurrency(runningBalance, entry.credit), entry.debit);\n      updateStmt.run(runningBalance, entry.id);\n    }\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L212"}, {"caller_nid": "ledgerutils_rebuildledgerbalances", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L212"}, {"caller_nid": "ledgerutils_updatebalancesfrom", "callee": "db.transaction(() => {\n    const anchorRow = db.prepare(\n      'SELECT transaction_date, id FROM customer_ledger WHERE id = ?'\n    ).get(fromEntryId) as { transaction_date: string; id: number } | undefined;\n    if (!anchorRow) {\n      rebuildLedgerBalances(customerId);\n      return;\n    }\n\n    // Seed: net of all active rows strictly before the changed row's position\n    const seedRow = db.prepare(`\n      SELECT COALESCE(SUM(debit), 0) - COALESCE(SUM(credit), 0) AS net\n      FROM customer_ledger\n      WHERE customer_id = ? AND voided = 0 AND reversed_by IS NULL\n        AND (transaction_date < ? OR (transaction_date = ? AND id < ?))\n    `).get(customerId, anchorRow.transaction_date, anchorRow.transaction_date, fromEntryId) as { net: number };\n\n    const tail = db.prepare(`\n      SELECT id, debit, credit FROM customer_ledger\n      WHERE customer_id = ? AND voided = 0 AND reversed_by IS NULL\n        AND (transaction_date > ? OR (transaction_date = ? AND id >= ?))\n      ORDER BY transaction_date ASC, id ASC\n    `).all(customerId, anchorRow.transaction_date, anchorRow.transaction_date, fromEntryId) as Array<{ id: number; debit: number; credit: number }>;\n\n    let running = parseCurrency(seedRow.net);\n    const updateStmt = db.prepare('UPDATE customer_ledger SET balance = ? WHERE id = ?');\n    for (const entry of tail) {\n      running = addCurrency(subtractCurrency(running, entry.credit), entry.debit);\n      updateStmt.run(running, entry.id);\n    }\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L238"}, {"caller_nid": "ledgerutils_updatebalancesfrom", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L238"}, {"caller_nid": "ledgerutils_recalccustomerbalancefromledger", "callee": "db.transaction(() => {\n    const row = db.prepare(`\n      SELECT COALESCE(SUM(debit), 0) - COALESCE(SUM(credit), 0) AS net\n      FROM customer_ledger\n      WHERE customer_id = ? AND voided = 0 AND reversed_by IS NULL\n    `).get(customerId) as { net: number };\n\n    const newBalance = parseCurrency(row.net);\n    db.prepare('UPDATE customers SET current_balance = ? WHERE id = ?').run(newBalance, customerId);\n    return newBalance;\n  })", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L276"}, {"caller_nid": "ledgerutils_recalccustomerbalancefromledger", "callee": "transaction", "source_file": "/media/fawad/26F2EFA7F2EF7987/D/minierp-flutter/server/src/utils/ledgerUtils.ts", "source_location": "L276"}]}