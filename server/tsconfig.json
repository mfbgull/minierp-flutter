{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    // Full strict mode. Enabled after the strictNullChecks rollout reached 0
    // errors; the remaining flags (noImplicitAny, strictPropertyInitialization,
    // useUnknownInCatchVariables, ...) surfaced only 2 further errors, both
    // callback-parameter widenings in config/database.ts. See
    // STRICT_NULL_CHECKS.md.
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    /* Allow JS files during migration */
    "allowJs": true,
    "checkJs": false,

    /* Paths */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "server.ts"],
  "exclude": ["node_modules", "dist"]
}
