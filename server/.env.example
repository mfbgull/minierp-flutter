# =============================================================================
# Mini ERP - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# Server Configuration
PORT=3011

# Bind address - defaults to 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to accept external connections (requires firewall).
BIND_ADDRESS=127.0.0.1

# Environment: development | production | test
# production activates rate limiters and requires DEFAULT_ADMIN_PASSWORD +
# ALLOWED_ORIGINS to be set (the server refuses to start otherwise).
NODE_ENV=production
LOG_LEVEL=info

# =============================================================================
# SECURITY - CRITICAL
# =============================================================================

# JWT Secret - REQUIRED. Generate one with: openssl rand -base64 64
# Server will refuse to start without this set.
JWT_SECRET=

# Encryption key for API keys at rest.
# Falls back to JWT_SECRET if not set.
# ENCRYPTION_KEY=

# Default admin password - REQUIRED in production (for first-time DB setup only).
# If not set in production, server will refuse to start.
DEFAULT_ADMIN_PASSWORD=

# Allowed CORS Origins (comma-separated, no spaces)
# In production, restrict to your actual frontend domain.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3011

# =============================================================================
# DATABASE
# =============================================================================

# Path to SQLite database file (relative to server/ directory)
# DATABASE_PATH=./database/erp.db

# =============================================================================
# REPORTING
# =============================================================================

# Default tax rate for tax summary reports (e.g., 0.10 for 10%)
# Can also be configured via Settings page.
# TAX_RATE=0.10

# =============================================================================
# OPTIONAL: External Services
# =============================================================================

# SendGrid Email
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio SMS
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Exchange Rates API
# EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Weather API
# WEATHER_API_KEY=your_weather_api_key

# JWT_SECRET rotation (audit-remediation 7.2):
# 1. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 2. Replace JWT_SECRET in this file and restart the server (all sessions invalidate).
# 3. Never commit the real value — only rotate in the deployed .env.
