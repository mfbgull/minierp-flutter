{
  "name": "mini-erp-server",
  "version": "1.0.0",
  "description": "Mini ERP Backend - Node.js + Express + SQLite",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node dist/server.js",
    "build": "tsc && rm -rf dist/migrations && cp -r src/migrations dist/migrations && rm -rf dist/src/migrations && mkdir -p dist/src && cp -r src/migrations dist/src/migrations",
    "start:prod": "node dist/server.js",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit",
    "db:backup": "node scripts/backup-db.js",
    "gl:dedupe-po": "node scripts/dedupe-po.js",
    "gl:backfill-ledger-dates": "node scripts/backfill-ledger-dates.js",
    "gl:recompute-item-amounts": "node scripts/recompute-item-amounts.js",
    "repair:unbatched-stock": "ts-node scripts/repair-stock.ts unbatched-stock",
    "repair:orphaned-batches": "ts-node scripts/repair-stock.ts orphaned-batches",
    "repair": "ts-node scripts/repair-stock.ts all",
    "gl:check": "ts-node scripts/check-gl-integrity.ts"
  },
  "keywords": [
    "erp",
    "inventory",
    "manufacturing",
    "sqlite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sqlite3": "^5.1.7",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.5.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1"
  }
}
